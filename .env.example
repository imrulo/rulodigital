# WhatsApp (solo dígitos, sin + ni espacios). Usa un número del mercado ES/EU en producción.
NEXT_PUBLIC_WHATSAPP_PHONE=34600000000

# Mensaje prellenado (alineado al CTA primario)
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola Rulo, quiero mi landing en 48h

# Email de contacto (visible en web + JSON-LD)
NEXT_PUBLIC_CONTACT_EMAIL=marketing@rulo.digital

# Logo (PNG). Cloudinary por defecto; sustituye si subes otro asset.
NEXT_PUBLIC_LOGO_URL=https://res.cloudinary.com/dhedmpc0f/image/upload/v1778754242/rulo_digital_logo_150u8n150u8n150u_p5pm7n.png

# Retrato “Sobre mí” (JPG/PNG/WebP público)
NEXT_PUBLIC_ABOUT_IMAGE_URL=https://res.cloudinary.com/dhedmpc0f/image/upload/v1778752609/63335114_dw6rrw.jpg

# Hero full-bleed (imagen). Opcional: vídeo real en NEXT_PUBLIC_HERO_VIDEO_URL
# NEXT_PUBLIC_HERO_IMAGE_URL=
# NEXT_PUBLIC_HERO_VIDEO_URL=

# URL canónica del sitio (producción)
NEXT_PUBLIC_SITE_URL=https://rulo.digital

# Aviso legal LSSI (obligatorio en producción cuando tengas datos reales)
# NEXT_PUBLIC_LEGAL_NAME=Nombre Apellidos o Razón Social S.L.
# NEXT_PUBLIC_LEGAL_TAX_ID=12345678A
# NEXT_PUBLIC_LEGAL_ADDRESS=Calle, número, CP, ciudad, país
# NEXT_PUBLIC_LEGAL_REGISTRY=Inscrita en el Registro Mercantil de … Tomo … Folio … Hoja …

# Telegram opcional (sin @)
# NEXT_PUBLIC_TELEGRAM_USERNAME=tuusuario

# Lead magnet (Resend): envío del email con la checklist
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Rulo.digital <onboarding@resend.dev>"
